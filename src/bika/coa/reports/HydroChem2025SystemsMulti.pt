<tal:report
  i18n:domain="bika.coa"
  define="collection view/collection;
          laboratory view/laboratory;
          coa_num view/get_coa_number;
          reporter view/current_user;
          accredited_symbol string:★;
          outofrange_symbol string:⚠;
          footer python:view.get_footer_text();
          report_options python:options.get('report_options', {});
          attachments_per_row python:int(report_options.get('attachments_per_row', 2));
          attachments_per_row python:attachments_per_row<1 and 1 or attachments_per_row;
          page_width options/page_width|nothing;
          page_height options/page_height|nothing;
          content_width options/content_width|nothing;
          content_height options/content_height|nothing;
          content_width python: content_width + 25;
          pages python:view.get_pages_dynamic(options, 4, 4);
          report_images python:view.get_extended_report_images();
          styles python:view.get_coa_styles();
      ">

  <!-- Custom Report Controls -->
  <div id="controls" class="noprint">
    <div i18n:translate="" class="text-secondary mb-2">Custom Report Options</div>
    <!-- Attachments per row -->
    <div class="mb-3">
      <div class="input-group">
        <div class="input-group-prepend">
          <label class="input-group-text" for="attachments_per_row" i18n:translate="">
            Attachments per Row
          </label>
        </div>
        <input tal:attributes="value attachments_per_row"
               type="number"
               class="form-control"
               name="attachments_per_row"
               min="1"/>
      </div>
      <small class="form-text text-muted" i18n:translate="">
        Number of attachments rendered within one row per Analysis Request
      </small>
    </div>
  </div>

  <script type="text/javascript">
   console.info("######################################################################");
   window.options = "<tal:t replace='options'/>";
   console.log(window.options);
   console.info("######################################################################");
  </script>

  <tal:css>
    <style type="text/css">
     .report * { font: 9pt; }
     .report h1 { font-size: 140%; }
     .report h2 { font-size: 120%; }
     .report h3 { font-size: 110%; }
     .report .alnright { text-align: right; }
     .report .alnleft { text-align: left; }
     .report .alncenter { text-align: center; }
     .report .padtop { padding-top:1em; }
     .report { font-family: TitilliumText22L-Regular; }
     .report .font-size-140 { font-size: 140%; }
     .report .font-size-120 { font-size: 120%; }
     .report .font-size-100 { font-size: 100%; }
     .report .colon-after:after { content: ":"; }
     .report address { margin: 1rem 0; }
     .report table.noborder td, .report table.noborder th { border: none; }
     .report table.nopadding td { padding: 0; }
     .report td.no-padding {
      padding: 0 !important;
      background-clip: content-box; /* <---- */
      box-shadow: inset 0 0 0 1px #d9d9d9;
    }

    td.no-padding > div.cell-bg {
      width: 100%;
      height: 100%;
      background-color: #d9d9d9;
      box-sizing: border-box;
      padding: .3rem;
    }
     .report table td.label { padding-right: 0.3rem; font-weight: bold; }
     .report table td.paddedlabel { padding-left: 1.2rem;}
     .report .border-out { border-right: 1px solid #b7b7b7; border-left: 1px solid #b7b7b7;}
     .report .add-left-border { border-left: 1px solid #b7b7b7;}
     .report .add-right-border { border-right: 1px solid #b7b7b7;}
     .report table.range-table td { padding: 0 0.3rem 0 0; border: none; }
     .report .section-header h1 { font-size: 175%; }
     .report .section-header img.logo { max-height: 200px; margin-bottom: 10px }
     .report .barcode-hri { margin-top: -0.25em; font-size: 8pt; }
     .report .section-footer table td { border: none; }
     .report .section-footer {
       position: fixed;
       left: -20mm;
       bottom: -20mm;
       margin-left: 20mm;
       margin-top: 10mm;
       height: 20mm;
       width: 100%;
       text-align: left;
       font-size: 9pt;
     } 

    .footerContainer {
      position:relative;
      width:100%;
      height:100px;
    }

    .report .section-footer #footer-line {
      width: 100%;
      height: 2mm;
      border-top: 1px solid black;
     }

    .div-table {
      display: table;
      width: auto;
    }

    .span-two-rows {
    grid-row: span 2; /* Spans 2 rows */
    }

    .table-row {
      display: table-row;
    }

    .table-header {
      display: table-cell;
      padding-top : 4px;
      padding-bottom : 4px;
      font-weight: bold;
      border-top: 1px solid #b7b7b7;
      width: <tal:t replace="python:'{:.2f}mm'.format(content_width / (len(pages[0]) + 1))"/>;
    }

    .table-cell {
      display: table-cell;
      padding-top : 4px;
      padding-bottom : 4px;
      border-top: 1px solid #b7b7b7;
      width:  <tal:t replace="python:'{:.2f}mm'.format(content_width / (len(pages[0]) + 1))"/>;
    }

    .table-cell-padded {
      display: table-cell;
      padding-top : 4px;
      padding-bottom : 4px;
      padding-left : 9mm;
      border-top: 1px solid #b7b7b7;
      width:  <tal:t replace="python:'{:.2f}mm'.format((content_width / (len(pages[0]) + 1))-9)"/>;/*-9 from the padding-left amount*/
    }

    .table-cell-lower {
      display: table-cell;
      padding-top : 4px;
      padding-bottom : 4px;
      border-top: 1px solid #b7b7b7;
      border-bottom: 1px solid #b7b7b7;
      width:  <tal:t replace="python:'{:.2f}mm'.format(0.5*(content_width / (len(pages[0]) + 1)))"/>;
    }   

    .table-cell-category {
      display: table-cell;
      padding-top : 4px;
      padding-bottom : 4px;
      border-top: 1px solid #b7b7b7;
      width:  <tal:t replace="python:'{:.2f}mm'.format(0.5*(content_width / (len(pages[0]) + 1)))"/>;
    }

    .table-header-date {
      display: table-cell;
      padding: 4px;
      font-weight: bold;
      border-top: 1px solid #b7b7b7;
      width: 25mm;
    }

    .add-bottom-border {
      border-bottom: 1px solid #b7b7b7;
    }

    .table-cell-date {
      display: table-cell;
      padding: 1px;
      border-top: 1px solid #b7b7b7;
      width: 25mm;
    }

    .table-header-address {
      display: table-cell;
      padding: 4px;
      font-weight: bold;
      border-top: 1px solid #b7b7b7;
      width: 23mm;
    }

    .table-cell-address {
      display: table-cell;
      padding: 1px;
      border-top: 1px solid #b7b7b7;
      width: 23mm;
    }

    .info-col {
      width: <tal:t replace="python:'{:.2f}mm'.format(0.5*content_width)"/>;
    }

    .full-width {
      width: <tal:t replace="python:'{:.2f}mm'.format(content_width)"/>;
    }

    .remarks-block {
    border: 1px solid #b7b7b7;
    padding: 10px;
    margin: 10px 0;
    }

    .stick-right {
      float: right;
    }

    .page-break {
      page-break-after: always;
      display: block; /* Ensure it's not inline */
    }
    .color-setup {
      color: #434343;
    }
    .header-colour-bg {
      background-color: #7f2346;
      color: white;
    }
    .cell-colour-bg {
      background-color: #d9d9d9;
    }

     <tal:block condition="python:content_width and content_height">
     <tal:block condition="python:all([content_width, content_height])"
                   define="cw python:float(content_width);
                           ch python:float(content_height);">
     /* Ensure that the images stay within the borders */
     .report .section-attachments img {
       max-width: <tal:t replace="python:'{:.2f}mm'.format(cw / attachments_per_row)"/>;
       max-height: <tal:t replace="python:'{:.2f}mm'.format(ch * 0.75)"/>;
     }
     .report .section-resultsinterpretation img {
       max-width: <tal:t replace="python:'{:.2f}mm'.format(cw)"/>;
       max-height: <tal:t replace="python:'{:.2f}mm'.format(ch * 0.75)"/>;
     }
     </tal:block>

     @page {
       margin-left: 7mm;
       margin-right: 2mm;
       margin-top: 5mm;
       margin-bottom: 15mm;
       @bottom-right {
         vertical-align: top;
         margin-top: 2mm;
         font-size: 8pt;
         margin-right: 7mm;
         content: " Page "counter(page) " <tal:t i18n:translate=''> of </tal:t> " counter(pages);
       }
       @bottom-left {
         vertical-align: top;
         margin-top: 2mm;
         font-size: 8pt;
         content: "Certificate of Analysis";
       }
       @bottom-center {
         vertical-align: top;
         margin-top: 2mm;
         font-size: 8pt;
         content: "HydroChem";
       }
     }
    </style>
  </tal:css>

  <!-- Samplepoint Location error message start -->
  <tal:render condition="python: not view.same_sample_point_location(collection)">
    <div>
      <h1> Samples are not from the same System Location </h1>
    </div>
  </tal:render>
  <!-- Samplepoint Location error message end -->

  <!-- Different Verified dates error message start -->
  <tal:render condition="python: not view.verified_on_same_day(collection)">
    <div>
      <h1> Samples have not been verified on the same day </h1>
    </div>
  </tal:render>
  <!-- Different Verified Dates error message end -->

  <!-- Different Published dates error message start -->
  <tal:render condition="python: not view.published_on_same_day(collection)">
    <div>
      <h1> Samples have not been published on the same day </h1>
    </div>
  </tal:render>
  <!-- Different Published dates error message end -->

  <!-- Landscape error -->
  <tal:render condition="python: not view.is_orientation_landscape(options)">
    <div>
      <h2>The selected report can only be rendered in Landscape orientation(mode)!</h2>
      <p>To show the report, please change the orientation to Landscape on the
      report rendering options
      </p>
    </div>
  </tal:render>
  <!-- Landscape error end -->


  <!-- HEADER -->
  <tal:meets_conditions condition="python: view.meets_hydrochem_conditions(collection, **options)">
  <tal:render>
    <div class="content row section-header no-gutters">
      <!-- Header Table -->
      <div>
          <img class="logo image-fluid full-width" style="height: auto;"
                src = "++resource++bika.coa.images/HydroChemBanner.jpeg"/>
      </div>
    </div>
  </tal:render>
  <!-- /HEADER -->

  <!-- INFO -->
    <tal:render condition="python:len(collection)>0"
                define="primarymodel python:collection[0];
                        batch primarymodel/Batch;">
                
      <div class="row section-info no-gutters">
        <div class="full-width">
          <!-- Client Info -->
          <table class="table table-sm table-condensed">
            <colgroup>
              <col class="info-col"/>
              <col class="info-col"/>
            </colgroup>
            <tr>
              <td style="border:none;" class="align-top pr-2">
                <!-- Left Table -->
                <table class="color-setup table table-sm table-condensed table-bordered">
                  <colgroup>
                    <col style="width:32%"/>
                    <col style="width:68%"/>
                  </colgroup>
                  <!-- Contact Name(s) -->
                  <tr>
                    <td class="label no-padding " i18n:translate="">
                      <div class="cell-bg">Certificate Number</div>
                    </td>
                    <td class="field">
                        <div name="coa_num"  tal:content="string:${coa_num}"/>
                    </td>
                  </tr>
                  <!-- Client Name(s) -->
                  <tr>
                    <td class="label no-padding" i18n:translate="">
                      <div class="cell-bg">Contact</div>
                    </td>
                    <td class="field">
                      <tal:by_contact repeat="contact python:view.group_items_by('Contact', collection)">
                        <div tal:content="contact/Fullname|nothing"/>
                      </tal:by_contact>
                    </td>
                  </tr>
                  <!-- Tel Number -->
                  <tr>
                    <td class="label no-padding" i18n:translate="">
                      <div class="cell-bg">Telephone</div>
                    </td>
                    <td class="field">
                      <tal:by_contact repeat="contact python:view.group_items_by('Contact', collection)">
                        <div tal:condition="contact" tal:content="contact/Phone|nothing"/>
                      </tal:by_contact>
                    </td>
                  </tr>
                  <!-- Email Address -->
                  <tr>
                    <td class="label no-padding" i18n:translate="">
                      <div class="cell-bg">Email</div>
                    </td>
                    <td class="field">
                      <tal:by_contact repeat="contact python:view.group_items_by('Contact', collection)">
                        <tal:email tal:condition="contact/EmailAddress|nothing"
                                   tal:define="email contact/EmailAddress|nothing">
                            <a tal:content="email"
                               tal:attributes="href string:mailto:${email}"></a>
                        </tal:email>
                      </tal:by_contact>
                    </td>
                  </tr>
                </table>
              </td>
              <td style="border:none;" class="align-top pl-2" rowspan="2">
                <!-- Right Table -->
                <table class="color-setup table table-sm table-condensed ml-1 table-bordered"
                      tal:define="laboratory python:view.laboratory;">
                  <col style="width:35%"/>
                  <col style="width:65%"/>
                  <tr>
                    <td class="label no-padding" i18n:translate="">
                      <div class="cell-bg">Page</div>
                    </td>
                    <td class="field">
                        <div>1/number_of_pages</div>
                    </td>
                  </tr>
                  <!-- Client Name(s) -->
                  <tr>
                    <td class="label no-padding" i18n:translate="">
                      <div class="cell-bg">Lab</div>
                    </td>
                    <td class="field">
                            <div tal:replace="laboratory/title|nothing"/>
                    </td>
                  </tr>
                  <!-- Tel Number -->
                  <tr>
                    <td class="label no-padding" i18n:translate="">
                      <div class="cell-bg">Address</div>
                    </td>
                    <td class="field">
                              <span tal:replace="laboratory/PhysicalAddress/address|nothing"/>
                              <span tal:replace="laboratory/PhysicalAddress/city|nothing"/>
                    </td>
                  </tr>
                  <!-- Email Address -->
                  <tr>
                    <td class="label no-padding" i18n:translate="">
                      <div class="cell-bg">Email Address</div>
                    </td>
                    <td class="field">
                        <div tal:replace="laboratory/EmailAddress|nothing"/>
                    </td>
                  </tr>
                  <tr>
                    <td class="label no-padding" i18n:translate="">
                      <div class="cell-bg">Telephone</div>
                    </td>
                    <td class="field" tal:define="contact python:view.group_items_by('Contact', collection)">
                      <div tal:replace="laboratory/Phone|nothing"/>
                    </td>
                  </tr>
                  <tr>
                    <td class="label no-padding" i18n:translate="">
                      <div class="cell-bg">Date Received</div>
                    </td>
                    <td class="field">
                      <div tal:content="python:primarymodel.DateReceived and view.to_localized_date(primarymodel.DateReceived) or '-'"/>
                    </td>
                  </tr>
                  <tr>
                    <td class="label no-padding" i18n:translate="">
                      <div class="cell-bg">Date Verified</div>
                    </td>
                    <td class="field">
                      <span tal:content="python:primarymodel.getDateVerified() and view.to_localized_date(primarymodel.getDateVerified()) or '-'"/>
                    </td>
                  </tr>
                  <tr>
                    <td class="label no-padding" i18n:translate="">
                      <div class="cell-bg">Publisher</div>
                    </td>
                    <td class="field">
                      <tal:render define="publish python:view.get_publisher();">
                          <span tal:content="publish/publisher"/>
                      </tal:render>
                    </td>
                  </tr>
                  <tr>
                    <td class="label no-padding" i18n:translate="">
                      <div class="cell-bg">Date Published</div>
                    </td>
                    <td class="field" tal:define="contact python:view.group_items_by('Contact', collection)">
                      <div tal:content="python:view.to_localized_date(primarymodel.DatePublished or view.timestamp) or '-'"/>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
            <tr>
              <td style="border:none;" class="align-top pr-2">
                <!-- Left Table -->
                <table class="color-setup table table-sm table-condensed table-bordered">
                    <colgroup>
                      <col style="width:32%"/>
                      <col style="width:68%"/>
                    </colgroup>
                  <!-- Contact Name(s) -->
                  <tr>
                    <td class="label no-padding" i18n:translate="">
                      <div class="cell-bg">Client</div>
                    </td>
                    <td class="field">
                      <tal:by_client repeat="client python:view.group_items_by('Client', collection)">
                          <div tal:replace="client/Name|nothing"></div>
                      </tal:by_client>
                    </td>
                  </tr>
                  <!-- Tel Number -->
                  <tr>
                    <td class="label no-padding" i18n:translate="">
                      <div class="cell-bg">System Location</div>
                    </td>
                    <td class="field">
                        <tal:render define="primarysample python:collection[0];
                                            samplepointlocation python:primarysample.getSamplePointLocation();"
                                    condition="samplepointlocation">
                        <div tal:content="python:samplepointlocation.Title() or ''"/>
                        </tal:render>
                    </td>
                  </tr>
                  <!-- Email Address -->
                  <tr>
                    <td class="label no-padding" i18n:translate="">
                      <div class="cell-bg">Address</div>
                    </td>
                    <td class="field" tal:define="contact python:view.group_items_by('Contact', collection)">
                        <tal:render define="primarysample python:collection[0];
                                            samplepointlocation python:primarysample.getSamplePointLocation();"
                                    condition="samplepointlocation">
                            <span tal:content="python:view.get_location_address(samplepointlocation) or ''"/>
                        </tal:render>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
          </table>
        </div>
        <!-- Clear Floats
            https://github.com/Kozea/WeasyPrint/issues/36
        -->
      </div>
    </tal:render>

    <!-- Legend start -->
    <tal:render>
      <div class="row section-info no-gutters" style="margin-bottom: 30px;">
        <div class="full-width">
          <div style="height: 3px; background-color: #7f2346; margin-bottom: 10px;"></div>
          <div>
            <div>
              <h2 i18n:translate="">Legend</h2>
            </div>
            <div>
              <table style="width: 100%; border: none;">
                <tr>
                  <td style="width: 50%; padding-left: 2em; padding-right: 2em;"> <p i18n:translate="">
                    <span><img tal:attributes="src python:report_images['subcontracted_symbol_url']"/></span>
                    These methods have been subcontracted to an approved laboratory.</p></td>
                  <td style="width: 50%; padding-left: 2em; padding-right: 2em;"><p i18n:translate="">
                  <span><img tal:attributes="src python:report_images['outofrange_symbol_url']"/></span>
                  Result does not comply with the cited specification</p></td>
                </tr>
              </table>
            </div>
            <div>
                <p style="text-align: center;" i18n:translate="">
                    Test results are at a <span tal:content="string: ${laboratory/Confidence|nothing}%"></span>
                    confidence level.
                </p>
            </div>
          </div>
          <div style="width: 100%; height: 3px; background-color: #7f2346; margin-top: -10px;"></div>
        </div>
      </div>
    </tal:render>
    <!-- Legend end -->

    <!-- ALERTS -->
    <tal:render condition="python:True">
      <div class="page-break row section-alerts no-gutters">
        <div class="full-width">
          <tal:model repeat="model collection">
            <div class="alert alert-danger" tal:condition="model/is_invalid">
              <h2 class="alert-heading"><span tal:replace="model/getId"/></h2>
              <div i18n:translate="">This Analysis Request has been invalidated due to erroneously published results</div>
              <tal:invalidreport tal:define="child model/Retest"
                                tal:condition="child">
                <span i18n:translate="">This Analysis request has been replaced by</span>
                <a tal:attributes="href child/absolute_url"
                  tal:content="child/getId"></a>
              </tal:invalidreport>
            </div>

            <div class="alert alert-info" tal:condition="model/is_provisional">
              <h2 class="alert-heading"><span tal:replace="model/getId"/></h2>
              <div i18n:translate="">Provisional report</div>
            </div>
          </tal:model>
        </div>
      </div>
    </tal:render>


  <!-- PAGE HEADER -->
  <!-- THIS NEEDS TO REPEAT ON EVERY PAGE EXCEPT PAGE 1-->
    <tal:render condition="python: view.meets_hydrochem_conditions(collection, **options)">
      <div>
        <div class="row section-info no-gutters">
          <div>
            <img class="stick-right" style="max-width: 30%; height: auto;"
                  src = "++resource++bika.coa.images/HydroChemHeader.png"/>
          </div>
          <div class="full-width">
            <table class="table table-sm table-condensed">
              <colgroup>
                  <col style="width:60%"/>
                  <col style="width:40%"/>
              </colgroup>
              <tr>
                <td style="border:none;" class="align-top pr-2">
                <!-- Left Table -->
                  <table class="color-setup table table-sm table-condensed table-bordered">
                    <colgroup>
                      <col style="width:50%"/>
                      <col style="width:50%"/>
                    </colgroup>
                    <!-- Certificate Number -->
                      <tr>
                        <td class="label no-padding " i18n:translate="">
                          <div class="cell-bg">Certificate Number</div>
                        </td>
                        <td class="field">
                            <div tal:content="string:${coa_num}"/>
                        </td>
                      </tr>
                    <!-- Client Name(s) -->
                      <tr>
                        <td class="label no-padding" i18n:translate="">
                          <div class="cell-bg">Client</div>
                        </td>
                        <td class="field">
                          <tal:by_client repeat="client python:view.group_items_by('Client', collection)">
                              <div tal:replace="client/Name|nothing"></div>
                          </tal:by_client>
                        </td>
                      </tr>
                    <!-- Location -->
                      <tr>
                        <td class="label no-padding" i18n:translate="">
                          <div class="cell-bg">System Location</div>
                        </td>
                        <td class="field">
                            <tal:render define="primarysample python:collection[0];
                                                samplepointlocation python:primarysample.getSamplePointLocation();"
                                        condition="samplepointlocation">
                            <div tal:content="python:samplepointlocation.Title() or ''"/>
                            </tal:render>
                        </td>
                      </tr>
                  </table>
                </td>
                <td style="border:none;" class="align-top pl-2" rowspan="2">
                <!-- Right Table -->
                  <table class="color-setup table table-sm table-condensed ml-1 table-bordered"
                        tal:define="laboratory python:view.laboratory;">
                    <col style="width:35%"/>
                    <col style="width:65%"/>
                    <!-- Page Number -->
                      <tr>
                        <td class="label no-padding" i18n:translate="">
                          <div class="cell-bg">Page</div>
                        </td>
                        <td class="field">
                            <div>2/number_of_pages</div>
                        </td>
                      </tr>
                    <!-- Contact -->
                      <tr>
                        <td class="label no-padding" i18n:translate="">
                          <div class="cell-bg">Lab</div>
                        </td>
                        <td class="field">
                                <div tal:replace="laboratory/title|nothing"/>
                        </td>
                      </tr>
                    <!-- Email Address -->
                      <tr>
                        <td class="label no-padding" i18n:translate="">
                          <div class="cell-bg">Email Address</div>
                        </td>
                        <td class="field">
                            <div tal:replace="laboratory/EmailAddress|nothing"/>
                        </td>
                      </tr>
                    <!-- Tel Number -->
                      <tr>
                        <td class="label no-padding" i18n:translate="">
                          <div class="cell-bg">Telephone</div>
                        </td>
                        <td class="field" tal:define="contact python:view.group_items_by('Contact', collection)">
                          <div tal:replace="laboratory/Phone|nothing"/>
                        </td>
                      </tr>
                  </table>
                </td>
              </tr>
            </table>
          </div>
        </div>
      </div>
    </tal:render>
  <!-- /PAGE HEADER -->




<tal:page tal:repeat="page pages">

  <!-- Sample Information-->
  <tal:render condition="python:True"
              define="analyses_by_poc python:view.get_analyses_by_poc(collection);
                      categories_by_poc python:view.get_categories_by_poc(collection)">
    <div class="full-width" style="height: 3px; background-color: #7f2346; margin-bottom: 10px;"></div>
    <div class="row section-results no-gutters">
      <div class="w-100">
        <h1 i18n:translate="">Sample Information</h1>
          <div style="margin-bottom: 10px;" class="color-setup div-table small">
              <div class="table-row">
                <div class="header-colour-bg table-header" style="padding-left: 10px;">Sample ID</div>
                <tal:ar repeat="model page">
                  <div class="header-colour-bg table-cell-padded font-weight-normal">
                         <span tal:content="model/Title"/>
                  </div>
                </tal:ar>
              </div>
              <div class="table-row noborder" style="border:none !important">
                <div class="cell-colour-bg table-header noborder" style="padding-left: 10px;">
                        Client Sample ID
                </div>
                <tal:ar repeat="model page">
                    <tal:is_last_sample tal:condition="python: view.is_last_sample(page, model)">
                        <div class="table-cell-padded font-weight-normal  noborder add-right-border">
                            <span tal:content="python:model.ClientSampleID or '-'"/>
                        </div>
                    </tal:is_last_sample>
                    <tal:is_not_last_sample tal:condition="python: not view.is_last_sample(page, model)">
                        <div class="table-cell-padded font-weight-normal  noborder">
                            <span tal:content="python:model.ClientSampleID or '-'"/>
                        </div>
                    </tal:is_not_last_sample>
                </tal:ar>
              </div>
              <div class="table-row noborder">
                <div class="cell-colour-bg table-header noborder" style="padding-left: 10px;">
                    <span>Date Sampled</span>
                </div>
                <tal:ar repeat="model page">
                    <tal:is_last_sample tal:condition="python: view.is_last_sample(page, model)">
                        <div class="table-cell-padded font-weight-normal  noborder add-right-border">
                            <span tal:content="python:model.DateSampled and view.to_localized_date(model.DateSampled) or '-'"/>
                        </div>
                    </tal:is_last_sample>
                    <tal:is_not_last_sample tal:condition="python: not view.is_last_sample(page, model)">
                        <div class="table-cell-padded font-weight-normal  noborder">
                            <span tal:content="python:model.DateSampled and view.to_localized_date(model.DateSampled) or '-'"/>
                        </div>
                    </tal:is_not_last_sample>
                </tal:ar>
              </div>
              <div class="table-row noborder">
                <div class="cell-colour-bg table-header noborder" style="padding-left: 10px;">
                      <span>Sample Type</span>
                </div>
                <tal:ar repeat="model page">
                    <tal:is_last_sample tal:condition="python: view.is_last_sample(page, model)">
                        <div class="table-cell-padded font-weight-normal  noborder add-right-border">
                            <span tal:content="python:model.SampleTypeTitle or '-'"/>
                        </div>
                    </tal:is_last_sample>
                    <tal:is_not_last_sample tal:condition="python: not view.is_last_sample(page, model)">
                        <div class="table-cell-padded font-weight-normal  noborder">
                            <span tal:content="python:model.SampleTypeTitle or '-'"/>
                        </div>
                    </tal:is_not_last_sample>
                </tal:ar>
              </div>
              <div class="table-row noborder">
                <div class="cell-colour-bg table-header noborder" style="padding-left: 10px;">
                    <span>System</span>
                </div>
                <tal:ar repeat="model page">
                    <tal:is_last_sample tal:condition="python: view.is_last_sample(page, model)">
                        <div class="table-cell-padded font-weight-normal  noborder add-right-border">
                            <span tal:content="python:model.SamplePointTitle or '-'"/>
                        </div>
                    </tal:is_last_sample>
                    <tal:is_not_last_sample tal:condition="python: not view.is_last_sample(page, model)">
                        <div class="table-cell-padded font-weight-normal  noborder">
                            <span tal:content="python:model.SamplePointTitle or '-'"/>
                        </div>
                    </tal:is_not_last_sample>
                </tal:ar>
              </div>
              <div class="table-row noborder">
                <div class="cell-colour-bg table-header noborder add-bottom-border" style="padding-left: 10px;">
                    <span>Specification</span>
                </div>
                <tal:ar repeat="model page">
                <tal:spec_values tal:define="specification model/Specification;
                                  publication_specification model/PublicationSpecification;
                                  spec python:publication_specification or specification;
                                  last_sample python: view.is_last_sample(page, model);">
                    <tal:is_last_sample tal:condition="python: last_sample">
                        <div class="table-cell-padded font-weight-normal noborder add-bottom-border add-right-border">
                        <span>
                            <span
                                tal:condition="spec"
                                tal:content="python:spec.Title() or '-'"/>
                            <span
                                tal:condition="not:spec"
                                tal:content="python:'-'"/>
                        </span>
                        </div>
                    </tal:is_last_sample>
                    <tal:is_not_last_sample tal:condition="python: not last_sample">
                        <div class="table-cell-padded font-weight-normal noborder add-bottom-border">
                        <span>
                            <span
                                tal:condition="spec"
                                tal:content="python:spec.Title() or '-'"/>
                            <span
                                tal:condition="not:spec"
                                tal:content="python:'-'"/>
                        </span>
                        </div>
                    </tal:is_not_last_sample>
                </tal:spec_values>
                </tal:ar>
              </div>
          </div>
      </div>
    </div>
  </tal:render>


<!-- Results start -->

    <tal:render condition="python:True"
                define="analyses_by_poc python:view.get_analyses_by_poc(collection);
                        categories_by_poc python:view.get_categories_by_poc(collection)">
      <!-- Point of Captures -->

        <div class="full-width" style="height: 3px; background-color: #7f2346; margin-bottom: 10px;"></div>
        <tal:poc tal:repeat="poc analyses_by_poc">
          <h2 tal:content="python:view.hydro_get_poc_title(poc, analyses_by_poc)"></h2>
          <div class="div-table small" style="margin:0;">
            <div class="header-colour-bg table-row">
              <div class="table-header add-left-border" style="padding-left: 10px;">Compound/Analyte</div>
              <tal:ar repeat="model page">
                <div class="table-cell font-weight-normal border-out text-center">
                      <span tal:content="model/Title"/>
                </div>
              </tal:ar>
            </div>
	      </div>
	      <div class="color-setup div-table small">
            <tal:categories_in_poc tal:repeat="category python:view.sort_items(categories_by_poc.get(poc))">
              <div tal:condition="python:view.get_analyses_by(collection, poc=poc, category=category)" class="table-row">
                <div class="cell-colour-bg table-cell-category add-left-border font-weight-bold" style="padding-left: 10px;">
                  <span tal:content="category/Title"/>
                </div>
		        <div class="cell-colour-bg table-cell-lower font-weight-bold text-center">Unit</div>
                <tal:results repeat="model page">
                  <div class="cell-colour-bg table-cell-lower font-weight-bold text-center add-left-border">Result</div>
		          <div class="cell-colour-bg table-cell-lower font-weight-bold text-center add-right-border">(Min-Max)</div>
                </tal:results>
              </div>
              <div class="table-row" tal:define="common_row_data python:view.get_common_row_data_green(page, poc=poc, category=category)"
                      tal:repeat="row_data python:common_row_data">
                <div class="table-cell-lower text-secondary add-left-border" style="padding-left: 10px;">
                  <span tal:condition="python: row_data[4]">
                    <img tal:attributes="src python:report_images['accredited_symbol_url']"/>
                  </span>
                  <span tal:condition="python: row_data[5]">
                    <img tal:attributes="src python:report_images['subcontracted_symbol_url']"/>
                  </span>
                  <span tal:condition="python: row_data[6]">
                    <img tal:attributes="src python:report_images['savcregistered_symbol_url']"/>
                  </span>
                  <span tal:content="python: row_data[0]"/>
                </div>
                <div class="table-cell-lower text-secondary text-center">
                  <span tal:content="python: row_data[2]"/>
                </div>
                <!-- Result values -->
                <tal:results repeat="model page">
                  <tal:analyses tal:define="analyses python:view.get_analyses_by(model, title=row_data[0]);">
                    <tal:analysis tal:repeat="analysis analyses">
                      <div class="table-cell-lower text-center add-left-border"
                              tal:define="result python:model.get_formatted_result(analysis);
                                          verified python:analysis.review_state in ['published', 'verified']">
                        <span class="font-weight-normal"
                              tal:condition="python:result and verified"
                              tal:content="structure result" />
                        <span class="font-weight-normal"
                              tal:condition="python:result and not verified">-</span>
                        <span class="font-weight-normal"
                              tal:condition="not:result"></span>
                        <span tal:condition="python:model.is_out_of_range(analysis)"
                              class="font-weight-normal">
                          <span class="outofrange text-danger">
                                <img tal:attributes="src python:report_images['outofrange_symbol_url']"/>
                          </span>
                        </span>
                      </div>
                      <tal:has_specs tal:define="spec python:view.get_formatted_specs_hydro(model, analysis)">
                        <tal:spec_in_analysis tal:condition="spec">
                          <div class="table-cell-lower text-center add-right-border">
		            <span tal:content="structure spec"/>
                          </div>
                        </tal:spec_in_analysis>
                        <tal:no_spec tal:condition="not:spec">
                          <div class="table-cell-lower text-center add-right-border"></div>
                        </tal:no_spec>
                      </tal:has_specs>
                    </tal:analysis>
                    <tal:analysis condition="not:analyses">
                      <div class='table-cell-lower add-left-border'></div>
                      <div class='table-cell-lower add-right-border'></div>
                    </tal:analysis>
                  </tal:analyses>
                </tal:results>
              </div>
            </tal:categories_in_poc>
          </div>
          <br />
          <br />
        </tal:poc>
    </tal:render>
 </tal:page>
 <div class="full-width" style="height: 3px; background-color: #7f2346; margin-bottom: 10px;"></div>
 <div class="page-break"></div>
<!-- Results end -->

  <!-- PAGE HEADER -->
  <!-- THIS NEEDS TO REPEAT ON EVERY PAGE EXCEPT PAGE 1-->
    <tal:render condition="python: view.meets_hydrochem_conditions(collection, **options)">
      <div>
        <div class="row section-info no-gutters">
          <div>
            <img class="stick-right" style="max-width: 30%; height: auto;"
                  src = "++resource++bika.coa.images/HydroChemHeader.png"/>
          </div>
          <div class="full-width">
            <table class="table table-sm table-condensed">
              <colgroup>
                  <col style="width:60%"/>
                  <col style="width:40%"/>
              </colgroup>
              <tr>
                <td style="border:none;" class="align-top pr-2">
                <!-- Left Table -->
                  <table class="color-setup table table-sm table-condensed table-bordered">
                    <colgroup>
                      <col style="width:50%"/>
                      <col style="width:50%"/>
                    </colgroup>
                    <!-- Certificate Number -->
                      <tr>
                        <td class="label no-padding " i18n:translate="">
                          <div class="cell-bg">Certificate Number</div>
                        </td>
                        <td class="field">
                            <div tal:content="string:${coa_num}"/>
                        </td>
                      </tr>
                    <!-- Client Name(s) -->
                      <tr>
                        <td class="label no-padding" i18n:translate="">
                          <div class="cell-bg">Client</div>
                        </td>
                        <td class="field">
                          <tal:by_client repeat="client python:view.group_items_by('Client', collection)">
                              <div tal:replace="client/Name|nothing"></div>
                          </tal:by_client>
                        </td>
                      </tr>
                    <!-- Location -->
                      <tr>
                        <td class="label no-padding" i18n:translate="">
                          <div class="cell-bg">System Location</div>
                        </td>
                        <td class="field">
                            <tal:render define="primarysample python:collection[0];
                                                samplepointlocation python:primarysample.getSamplePointLocation();"
                                        condition="samplepointlocation">
                            <div tal:content="python:samplepointlocation.Title() or ''"/>
                            </tal:render>
                        </td>
                      </tr>
                  </table>
                </td>
                <td style="border:none;" class="align-top pl-2" rowspan="2">
                <!-- Right Table -->
                  <table class="color-setup table table-sm table-condensed ml-1 table-bordered"
                        tal:define="laboratory python:view.laboratory;">
                    <col style="width:35%"/>
                    <col style="width:65%"/>
                    <!-- Page Number -->
                      <tr>
                        <td class="label no-padding" i18n:translate="">
                          <div class="cell-bg">Page</div>
                        </td>
                        <td class="field">
                            <div>last/number_of_pages</div>
                        </td>
                      </tr>
                    <!-- Contact -->
                      <tr>
                        <td class="label no-padding" i18n:translate="">
                          <div class="cell-bg">Lab</div>
                        </td>
                        <td class="field">
                                <div tal:replace="laboratory/title|nothing"/>
                        </td>
                      </tr>
                    <!-- Email Address -->
                      <tr>
                        <td class="label no-padding" i18n:translate="">
                          <div class="cell-bg">Email Address</div>
                        </td>
                        <td class="field">
                            <div tal:replace="laboratory/EmailAddress|nothing"/>
                        </td>
                      </tr>
                    <!-- Tel Number -->
                      <tr>
                        <td class="label no-padding" i18n:translate="">
                          <div class="cell-bg">Telephone</div>
                        </td>
                        <td class="field" tal:define="contact python:view.group_items_by('Contact', collection)">
                          <div tal:replace="laboratory/Phone|nothing"/>
                        </td>
                      </tr>
                  </table>
                </td>
              </tr>
            </table>
          </div>
        </div>
      </div>
    </tal:render>
  <!-- /PAGE HEADER -->

    <!--  RESULTS INTERPRETATIONS -->
    <tal:render condition="python:True">
      <tal:model repeat="model collection">
        <div class="row section-resultsinterpretation no-gutters"
            tal:define="ris python:model.get_resultsinterpretation();
                        has_ri python:any(map(lambda r: r.get('richtext'), ris));">
          <div class="" tal:condition="has_ri">
            <h1 i18n:translate>Results Interpretation for <span tal:replace="model/getId"/></h1>
            <tal:ri repeat="ri ris">
              <h2 tal:condition="ri/richtext|nothing" tal:content="ri/title|nothing">Department</h2>
              <div class="text-info" tal:content="structure ri/richtext|nothing"></div>
            </tal:ri>
          </div>
        </div>
      </tal:model>
    </tal:render>

    <!-- REMARKS -->
    <tal:render condition="python:True"
                define="primarymodel python:collection[0];
                        batch primarymodel/Batch;">
        <tal:has_remarks condition="python: batch and batch.get('COARemarks', '')">
            <div class="row section-remarks no-gutters full-width">
                <div class="remarks-block">
                    <div tal:content="structure batch/COARemarks"></div>
                </div>
            </div>
        </tal:has_remarks>
    </tal:render>


  <!--  SIGNATURES -->
  <tal:render condition="python:True">
    <tal:responsibles define="managers python:view.uniquify_items(reduce(lambda a1, a2: a1+a2, map(lambda m: m.managers, collection)))">
      <div class="row section-signatures no-gutters">
          <div class="full-width" style="height: 3px; background-color: #7f2346; margin-bottom: 0px;"></div>
          <div class="full-width">
          <tal:render define="publish python:view.get_publisher();
                             primarymodel python:collection[0];
                             Verifier python:view.get_verifier(collection)">
           <table class="table table-sm table-condensed noborder">
            <colgroup>
              <col style="width:25%"/>
              <col style="width:25%"/>
              <col style="width:25%"/>
              <col style="width:25%"/>
            </colgroup>
            <tr>
                <td i18n:translate="">
                  <div class="font-weight-bold">
                  Manager
                  </div>
                </td>
                <td i18n:translate="">
                </td>
                <td i18n:translate="">
                  <div class="font-weight-bold">Publisher</div>
                </td>
                <td i18n:translate="">
                  <div class="font-weight-bold">Date Published</div>
                </td>
            </tr>
            <tr>
              <tal:manager repeat="manager managers">
                <td>
                    <span tal:content="manager/getFullname"></span>
                </td>
                <td>
                    <tal:email tal:condition="manager/EmailAddress|nothing"
                               tal:define="email manager/EmailAddress|nothing">
                        <a tal:content="email"
                           tal:attributes="href string:mailto:${email}"></a>
                    </tal:email>
                </td>
              </tal:manager>
                <td>
                   <div tal:content="publish/publisher"/>
                </td>
                <td>
                   <div
                       tal:content="python:view.to_localized_date(primarymodel.DatePublished or view.timestamp)"/>
                </td>
            </tr>
           </table>
          </tal:render>
         </div>
         <div class="full-width" style="height: 3px; background-color: #7f2346; margin-bottom: 10px; margin-top: -10px; "></div>
      </div>
    </tal:responsibles>
  </tal:render>


    <!-- ATTACHMENTS -->
    <tal:render condition="python:True">
      <div class="full-width row section-attachments no-gutters">
        <tal:model repeat="model collection">
          <tal:attachment tal:define="attachments python:model.get_sorted_attachments('r');">
            <h2 i18n:translate=""
                tal:condition="attachments">
              Attachments for <span tal:replace="model/getId"/>
            </h2>
            <table class="table w-100" tal:condition="attachments">
              <colgroup tal:condition="python:len(attachments) > 1">
                <col tal:repeat="col python:range(attachments_per_row)"
                    tal:attributes="style python:'width:{}%'.format(100/attachments_per_row)">
              </colgroup>
              <tr tal:repeat="chunk python:view.group_into_chunks(attachments, attachments_per_row)">
                <td class="align-bottom"
                    style="border:none;padding-left:0;"
                    tal:repeat="attachment chunk">
                  <figure class="figure">
                    <img class="figure-img img-fluid"
                        tal:attributes="src string:${attachment/absolute_url}/AttachmentFile;"/>
                    <figcaption class="figure-caption pt-2">
                      <div class="att_for">
                        <span i18n:translate="">Attachment for</span>
                        <span tal:content="attachment/getTextTitle|model/getId"/>
                      </div>
                      <div class="att_keys">
                        <span tal:content="attachment/AttachmentKeys"/>
                      </div>
                      <div class="att_filename">
                        <span i18n:translate="">Filename:</span>
                        <span tal:content="attachment/AttachmentFile/filename"/>
                      </div>
                    </figcaption>
                  </figure>
                </td>
              </tr>
            </table>
          </tal:attachment>
        </tal:model>
      </div>
    </tal:render>

    <tal:render>
      <h1> End of Certificate </h1>
      <p tal:content="string:This document shall not be reproduced except in full, without written approval of ${laboratory/title|nothing}"/>
    </tal:render>

    <!-- CUSTOM FOOTER -->
    <tal:render condition="python:footer">
      <div class="row section-footer no-gutters">
        <!-- Footer Line -->
        <div id="footer-line"></div>
        <div tal:replace="structure footer"/>
      </div>
    </tal:render>
  </tal:meets_conditions>
</tal:report>

