<configure xmlns="http://namespaces.zope.org/zope"
           xmlns:plone="http://namespaces.plone.org/plone">
  <include package="plone.behavior" file="meta.zcml" />
  <plone:behavior
      name="bika.coa.method_supplier"
      title="Method Supplier"
      description="Supplier responsible for a subcontracted method"
      provides=".methodsupplier.IMethodSupplier"
      factory=".methodsupplier.MethodSupplier"
      marker=".methodsupplier.IMethodSupplierMarker"
      for="senaite.core.interfaces.IMethod"
      />

</configure>
