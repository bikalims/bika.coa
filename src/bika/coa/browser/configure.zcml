<configure xmlns="http://namespaces.zope.org/zope"
           xmlns:browser="http://namespaces.zope.org/browser">

  <browser:viewlet
      name="bika.coa.batch.coa_remarks_templates"
      for="bika.lims.interfaces.IBatch"
      layer="bika.coa.interfaces.IBikaCOALayer"
      manager="plone.app.layout.viewlets.interfaces.IAboveContent"
      class=".coa_remarks.COARemarksTemplateSelector"
      template="templates/coa_remarks_templates.pt"
      permission="zope2.View"
      />

  <!-- Time-series resources for SENAITE Impress reports -->
  <browser:viewlet
      name="bika.coa.timeseries.resources"
      manager="senaite.impress.browser.viewlets.interfaces.IPublishCustomHtmlHeadViewlets"
      template="templates/timeseries_resources.pt"
      permission="zope2.View"
      layer="bika.coa.interfaces.IBikaCOALayer"
      />

  <include package=".listingview" />

</configure>
